{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node_modules/.bin/tsx scripts/hooks/session-start.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node_modules/.bin/tsx scripts/hooks/stop.ts"
          }
        ]
      }
    ]
  }
}
