# Copy to ~/.config/job-search/.env.local or another private env file outside git.
# Optional path overrides:
# JOB_SEARCH_APP_ROOT=$HOME/.local/opt/job-search
# JOB_SEARCH_CONFIG_DIR=$HOME/.config/job-search
# JOB_SEARCH_DATA_DIR=$HOME/.local/share/job-search
# JOB_SEARCH_STATE_DIR=$HOME/.local/state/job-search
# JOB_SEARCH_CACHE_DIR=$HOME/.cache/job-search

# hh.ru OAuth
HH_CLIENT_ID=replace-me
HH_CLIENT_SECRET=replace-me
HH_REFRESH_TOKEN=replace-me

# Optional adapters
LINKEDIN_SESSION_TOKEN=replace-me
