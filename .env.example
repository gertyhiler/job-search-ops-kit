# ----------------------------------------------------------------------------
# job-search-ops-kit environment
# Copy to .env and fill in. Never commit .env.
# ----------------------------------------------------------------------------

# Logging
LOG_LEVEL=info

# Where runtime data lives (gitignored). Relative to repo root.
DATA_DIR=data
DATABASE_PATH=data/db/job-search.sqlite

# Pipeline cadence (seconds). Downstream queues run at min(POLL_INTERVAL_SEC, 30).
POLL_INTERVAL_SEC=900

# AI CLI subprocess settings. Models use "{provider}.{model}".
# Providers: codex -> `codex exec`, cursor -> `agent`, claude -> `claude -p`.
FAST_MODEL=cursor.composer_2_5_fast
DRAFT_MODEL=codex.gpt_5_2
REASONING_MODEL=codex.gpt_5_2
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=1

# Telegram (notifications + approvals). Leave empty to disable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HH.ru — search and apply use a saved Playwright browser session (job-search hh:login).
# Optional descriptive user-agent for outbound requests.
HH_USER_AGENT=job-search-ops-kit/0.1 (replace-me@example.com)
# Deprecated: applicant API was discontinued Dec 2025; OAuth is unused.
# HH_CLIENT_ID=
# HH_CLIENT_SECRET=
# HH_OAUTH_TOKEN=

# Auto-apply runtime mode: dry_run (default, no submissions) or real.
AUTO_APPLY_MODE=dry_run

# Resume renderer (Typst binary on PATH).
TYPST_BIN=typst

# Memory consolidation trigger: run after this many new events accumulate.
CONSOLIDATION_EVENT_THRESHOLD=25
