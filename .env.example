# ----------------------------------------------------------------------------
# job-search-ops-kit environment
# Copy to .env and fill in. Never commit .env.
# ----------------------------------------------------------------------------

# Logging
LOG_LEVEL=info

# Where runtime data lives (gitignored). Relative to repo root.
DATA_DIR=data
DATABASE_PATH=data/db/job-search.sqlite

# Pipeline cadence (seconds). Downstream queues run at min(POLL_INTERVAL_SEC, 30).
POLL_INTERVAL_SEC=900

# AI CLI subprocess settings. Models use "{provider}.{model}".
# Providers: codex -> `codex exec`, cursor -> `agent`, claude -> `claude -p`.
FAST_MODEL=codex.gpt-5.4-mini
DRAFT_MODEL=codex.gpt-5.4
REASONING_MODEL=codex.gpt-5.4
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=1
# Cover letters: route (auto=template, high_value=AI), template, or ai.
COVER_LETTER_MODE=route

# Telegram (notifications + approvals). Leave empty to disable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Long-poll for /status and inline approve buttons. false = send-only (no 409 if another consumer exists).
TELEGRAM_POLLING=true

# Playwright browser context (global default for future non-HH flows).
# Empty PLAYWRIGHT_USER_AGENT = Desktop Chrome fingerprint at runtime.
PLAYWRIGHT_USER_AGENT=
PLAYWRIGHT_LOCALE=en-US
PLAYWRIGHT_VIEWPORT_WIDTH=1280
PLAYWRIGHT_VIEWPORT_HEIGHT=720

# HH.ru — search, apply, hh:login (job-search hh:login for session).
# Separate from PLAYWRIGHT_*; not merged.
HH_PLAYWRIGHT_USER_AGENT=
HH_PLAYWRIGHT_LOCALE=ru-RU
HH_PLAYWRIGHT_VIEWPORT_WIDTH=1280
HH_PLAYWRIGHT_VIEWPORT_HEIGHT=900

# Auto-apply runtime mode: dry_run (default, no submissions) or real.
AUTO_APPLY_MODE=dry_run

# Resume renderer (Typst binary on PATH).
TYPST_BIN=typst

# Memory consolidation trigger: run after this many new events accumulate.
CONSOLIDATION_EVENT_THRESHOLD=25
