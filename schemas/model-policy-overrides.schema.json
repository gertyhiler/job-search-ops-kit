{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-search/model-policy-overrides",
  "title": "ModelPolicyOverrides",
  "type": "object",
  "properties": {
    "defaults": {
      "type": "object",
      "properties": {
        "model": { "type": ["string", "null"] },
        "reasoning_effort": { "type": ["string", "null"] },
        "allow_tools": { "type": ["boolean", "null"] },
        "fallback_model": { "type": ["string", "null"] },
        "escalate_when": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "workload_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["match", "route"],
        "properties": {
          "id": { "type": ["string", "null"] },
          "match": {
            "type": "object",
            "properties": {
              "role": { "type": "array", "items": { "type": "string" } },
              "task_kind": { "type": "array", "items": { "type": "string" } },
              "domain": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          },
          "route": {
            "type": "object",
            "properties": {
              "mode": { "type": ["string", "null"] },
              "model": { "type": ["string", "null"] },
              "reasoning_effort": { "type": ["string", "null"] },
              "allow_tools": { "type": ["boolean", "null"] },
              "fallback_model": { "type": ["string", "null"] },
              "escalate_when": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
