{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-search/application-event",
  "title": "ApplicationEvent",
  "description": "Append-only lifecycle event for an application. Source of truth for funnel.",
  "type": "object",
  "required": ["id", "application_id", "ts", "kind"],
  "properties": {
    "id": { "type": "string" },
    "application_id": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" },
    "kind": {
      "type": "string",
      "enum": [
        "applied",
        "apply_failed",
        "viewed",
        "screened",
        "invited",
        "rescheduled",
        "technical",
        "final",
        "offer",
        "rejected",
        "ghosted",
        "withdrawn"
      ]
    },
    "payload": { "type": ["object", "null"] },
    "evidence_ref": { "type": ["string", "null"] },
    "emitted_by": { "type": ["string", "null"], "description": "role or script that produced the event" }
  },
  "additionalProperties": true
}
