{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-search/application",
  "title": "Application",
  "type": "object",
  "required": ["id", "vacancy_id", "channel", "status"],
  "properties": {
    "id": { "type": "string" },
    "vacancy_id": { "type": "string" },
    "resume_version_id": { "type": ["string", "null"] },
    "cover_letter_id": { "type": ["string", "null"] },
    "channel": { "type": "string", "enum": ["hh", "site", "linkedin", "referral", "agency"] },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "dry_run",
        "review_blocked",
        "ready_to_send",
        "outbox_prepared",
        "applied",
        "screened",
        "interviewing",
        "offer",
        "rejected",
        "withdrawn",
        "archived"
      ]
    },
    "applied_at": { "type": ["string", "null"], "format": "date-time" },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "auto_sent": { "type": "boolean" },
    "dry_run": { "type": "boolean" },
    "last_status_reason": { "type": ["string", "null"] },
    "last_status_evidence_ref": { "type": ["string", "null"] },
    "last_status_human_confirmation": { "type": "boolean" }
  },
  "additionalProperties": true
}
