{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-search/escalation-rules",
  "title": "EscalationRules",
  "type": "object",
  "required": ["auto_accept_max_confidence", "weekly_change_cap", "escalate_when", "hard_stop_conditions"],
  "properties": {
    "auto_accept_max_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "weekly_change_cap": { "type": "number", "minimum": 0 },
    "escalate_when": { "type": "array", "items": { "type": "string" } },
    "hard_stop_conditions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
