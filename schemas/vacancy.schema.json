{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-search/vacancy",
  "title": "Vacancy",
  "type": "object",
  "required": ["id", "source", "company", "title", "status", "first_seen_at"],
  "properties": {
    "id": { "type": "string" },
    "source": { "type": "string", "enum": ["hh", "linkedin", "site", "referral", "agency", "other"] },
    "source_id": { "type": ["string", "null"] },
    "url": { "type": ["string", "null"], "format": "uri" },
    "company": { "type": "string" },
    "title": { "type": "string" },
    "location": { "type": ["string", "null"] },
    "remote": { "type": "string", "enum": ["remote", "onsite", "hybrid", "unknown"] },
    "salary_min": { "type": ["number", "null"] },
    "salary_max": { "type": ["number", "null"] },
    "currency": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "jd_markdown_path": { "type": ["string", "null"] },
    "match_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "match_rationale": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["candidate", "archived", "applied", "dropped"] },
    "first_seen_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
