{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-search/runtime-settings",
  "title": "RuntimeSettings",
  "type": "object",
  "required": ["selected_runner_adapter", "default_run_mode", "approvals_policy"],
  "properties": {
    "selected_runner_adapter": { "type": "string", "enum": ["codex-cli", "cursor-cli"] },
    "default_run_mode": { "type": "string", "enum": ["background", "supervised", "interactive_external"] },
    "approvals_policy": { "type": "string", "enum": ["ask", "auto-safe", "manual-only"] },
    "browser_supervision": {
      "type": "object",
      "properties": {
        "prefer_supervised": { "type": "boolean" },
        "fallback_to_external": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
