{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-search/resume-theme",
  "title": "ResumeTheme",
  "type": "object",
  "required": ["theme_name", "page_size", "accent_color", "font_scale"],
  "properties": {
    "theme_name": { "type": "string" },
    "page_size": { "type": "string", "enum": ["A4", "Letter"] },
    "accent_color": { "type": "string" },
    "font_scale": { "type": "number", "minimum": 0.5, "maximum": 2 },
    "density": { "type": ["string", "null"], "enum": [null, "compact", "balanced", "airy"] }
  },
  "additionalProperties": true
}
