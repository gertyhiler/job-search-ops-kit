{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-search/strategy-change-proposal",
  "title": "StrategyChangeProposal",
  "type": "object",
  "required": ["id", "ts", "before", "after", "rationale", "confidence", "reversibility"],
  "properties": {
    "id": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" },
    "before": { "type": "object" },
    "after": { "type": "object" },
    "rationale": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "expected_impact": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reversibility": { "type": "string", "enum": ["trivial", "moderate", "hard"] },
    "proposed_by": { "type": ["string", "null"] },
    "decision": {
      "type": ["string", "null"],
      "enum": [null, "auto_accept", "auto_defer", "auto_reject", "escalate_to_human", "reverted"]
    },
    "applied_version": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
