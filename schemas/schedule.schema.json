{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-search/schedule",
  "title": "Schedule",
  "description": "DB-driven scheduled task. Source of truth for when an automation runs next.",
  "type": "object",
  "required": ["id", "cron", "role", "prompt_file", "enabled", "next_run_at", "catchup_policy"],
  "properties": {
    "id": { "type": "string" },
    "cron": { "type": "string" },
    "role": { "type": "string" },
    "model": { "type": ["string", "null"] },
    "prompt_file": { "type": "string" },
    "mcp_profile": { "type": ["string", "null"] },
    "dry_run": { "type": "boolean" },
    "enabled": { "type": "boolean" },
    "next_run_at": { "type": "string", "format": "date-time" },
    "last_run_at": { "type": ["string", "null"], "format": "date-time" },
    "last_status": { "type": ["string", "null"] },
    "catchup_policy": {
      "type": "string",
      "enum": ["run_once_if_overdue", "skip_if_stale", "run_all_missed"]
    },
    "max_staleness_sec": { "type": ["number", "null"] },
    "fails_in_a_row": { "type": "number" }
  },
  "additionalProperties": true
}
