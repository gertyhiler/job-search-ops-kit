{
  "name": "job-search-ops-kit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "control-plane:dev": "pnpm --dir packages/control-plane dev",
    "guard:privacy": "node scripts/privacy-guard.mjs --tracked",
    "validate": "pnpm run validate:foundation",
    "validate:foundation": "node scripts/validate-foundation.mjs",
    "db:migrate": "node --experimental-strip-types packages/cli/bin.ts db migrate",
    "db:replay": "node --experimental-strip-types packages/cli/bin.ts db replay",
    "build:operator": "node --experimental-strip-types scripts/build-operator.ts",
    "install:operator": "node --experimental-strip-types scripts/install-operator.ts",
    "update:operator": "node --experimental-strip-types scripts/update-operator.ts",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm run guard:privacy && pnpm run validate:foundation && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "turbo": "^2.0.14",
    "typescript": "^5.8.3"
  }
}
