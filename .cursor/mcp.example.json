{
  "mcpServers": {
    "job-search": {
      "command": "node",
      "args": ["${workspaceFolder}/packages/mcp-server/dist/index.js"],
      "env": {
        "JOB_SEARCH_DATA_DIR": "${workspaceFolder}/user-data"
      }
    },
    "headhunter": {
      "command": "uvx",
      "args": ["headhunter-mcp-server"],
      "env": {
        "HH_CLIENT_ID": "${env:HH_CLIENT_ID}",
        "HH_CLIENT_SECRET": "${env:HH_CLIENT_SECRET}",
        "HH_REFRESH_TOKEN": "${env:HH_REFRESH_TOKEN}"
      }
    },
    "browser-attended": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--attach"]
    }
  }
}
